{
  "manifest_version": 3,
  "name": "AEM CDN Toolkit",
  "version": "2.5.0",
  "minimum_chrome_version": "120",
  "description": "AEM CDN purge, country mappings, cache parameters and authenticated publish access.",
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AEM CDN Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolkit-neutral-16.png",
      "32": "icons/toolkit-neutral-32.png",
      "48": "icons/toolkit-neutral-48.png",
      "128": "icons/toolkit-neutral-128.png"
    }
  },
  "icons": {
    "16": "icons/toolkit-neutral-16.png",
    "32": "icons/toolkit-neutral-32.png",
    "48": "icons/toolkit-neutral-48.png",
    "128": "icons/toolkit-neutral-128.png"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "incognito": "not_allowed"
}
